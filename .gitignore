# ============================================================
# 环境变量与密钥（严禁上传）
# ============================================================
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
secrets.*

# Prompt 工程成果（不公开）
backend/app/prompts/*.txt

# ============================================================
# 用户数据与运行时产物（storage 约 7GB，绝不上传）
# ============================================================
storage/uploads/*
storage/pages/*
storage/results/*
storage/exports/*
!storage/**/.gitkeep

# OCR / PPT 生成产物（可重新生成）
output/
outputs/

# 项目内部文档与工具脚本（不公开）
docs/
word/
*.xlsx
pdf_v2.py
generate_ppt.py
BUGFIX_*.md

# README 需要的资源保留
!assets/

# ============================================================
# Python
# ============================================================
