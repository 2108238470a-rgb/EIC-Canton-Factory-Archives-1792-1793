# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocr_platform
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# PaddleOCR Service
PADDLE_OCR_URL=http://YOUR_PADDLE_OCR_HOST:8888/layout-parsing
PADDLE_OCR_MODEL_NAME=PaddleOCR-VL-1.6
PADDLE_OCR_TIMEOUT_SECONDS=1800
PADDLE_OCR_CONNECT_TIMEOUT_SECONDS=10
PADDLE_OCR_WRITE_TIMEOUT_SECONDS=120
PADDLE_OCR_RETRIES=2
PADDLE_OCR_RETRY_BACKOFF_SECONDS=1.0
# 私网 OCR 地址默认不读取 HTTP_PROXY/HTTPS_PROXY，避免代理网关返回 502。
PADDLE_OCR_TRUST_ENV=false
# 单卡显存有限时限制为 1，避免多个长文档请求同时触发 OOM。
PADDLE_OCR_MAX_CONCURRENCY=1
PADDLE_OCR_MAX_FILE_MB=200
PADDLE_OCR_MAX_PIXELS=4194304
PADDLE_OCR_MAX_NEW_TOKENS=4096

# GPT Service
GPT_API_KEY=your-openai-compatible-api-key-here
GPT_BASE_URL=https://api.siliconflow.cn/v1
GPT_MODEL=deepseek-ai/DeepSeek-V3.2

# Storage
STORAGE_PATH=../storage
UPLOAD_PATH=../storage/uploads
PAGES_PATH=../storage/pages
RESULTS_PATH=../storage/results
EXPORTS_PATH=../storage/exports

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Historical document recognition budgets (future OCR runs only).
# Raise only within the deployed OCR server's context and GPU limits.
OCR_PDF_MAX_PIXELS=8388608
OCR_PDF_MAX_NEW_TOKENS=8192
OCR_IMAGE_MAX_PIXELS=8388608
OCR_IMAGE_MAX_NEW_TOKENS=8192

# Interactive Q&A generation deadline (all model attempts combined); keep below frontend proxy budget.
RAG_ANSWER_TIMEOUT_SECONDS=150
# Relative to backend/; missing file uses a generic multilingual profile.
CORRECTION_PROFILES_PATH=config/correction_profiles.local.json
